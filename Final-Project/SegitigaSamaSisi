public class SegitigaSamaSisi extends BangunDatar {
    double sisi;

    public SegitigaSamaSisi(double s) {
        super("Segitiga Sama Sisi");
        this.sisi = s;
    }

    public double hitungLuas() {
        return (sisi * sisi / 4) * Math.sqrt(3);
    }


    public double hitungKeliling() {
        return 3 * sisi;
    }
}
